APP_ENV=development
DATABASE_URL=sqlite:///./data/fithub_ai.db
OPENAI_API_KEY=
YOUTUBE_API_KEY=
SECRET_KEY=replace-with-local-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SEED_ADMIN=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
CREWAI_STORAGE_DIR=.crewai-storage
CREWAI_TRACING_ENABLED=false
AI_LLM_PROVIDER=ollama
AI_RECOMMENDER_MODE=llm
AI_ALLOW_MOCK_FALLBACK=true
MODEL=ollama/llama3
BASE_URL=http://localhost:11434
